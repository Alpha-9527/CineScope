---
import { proxyImage } from '../lib/image';

interface Props {
  palette?: string;
  title: string;
  originalTitle?: string;
  year?: number;
  label?: string;
  src?: string;
  alt?: string;
  ratio?: 'poster' | 'wide' | 'square' | 'portrait' | 'fill';
  width?: number;
  eager?: boolean;
  class?: string;
  compact?: boolean;
  plain?: boolean;
}

const {
  palette = 'ink',
  title,
  originalTitle,
  year,
  label,
  src,
  alt,
  ratio = 'poster',
  width,
  eager = false,
  class: className = '',
  compact = false,
  plain = false,
} = Astro.props;

const ratioClass = {
  poster: 'aspect-[2/3]',
  wide: 'aspect-[16/9]',
  square: 'aspect-square',
  portrait: 'aspect-[3/4]',
  fill: 'h-full w-full',
}[ratio];

// 按展示尺寸取图，代理端不会放大超过原图
const defaultWidth = {
  poster: 500,
  wide: 1280,
  square: 600,
  portrait: 800,
  fill: 1600,
}[ratio];

const imageSrc = proxyImage(src, { width: width ?? defaultWidth });

const isWide = ratio === 'wide' || ratio === 'fill';
const glyph = title.trim().charAt(0);
const glyphClass = isWide
  ? 'right-[-1rem] bottom-[-4rem] text-[15rem] md:text-[20rem]'
  : 'right-[-0.5rem] bottom-[-1.5rem] text-[9rem] md:text-[11rem]';
---

<div class={`art art-${palette} ${ratioClass} ${className}`}>
  {
    src ? (
      <img
        src={imageSrc}
        alt={alt ?? `${title} 剧照`}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        referrerpolicy="no-referrer"
        class="absolute inset-0 z-[1] h-full w-full object-cover"
      />
    ) : (
      <div class="absolute inset-0 z-[1] overflow-hidden">
        <span
          class={`pointer-events-none absolute select-none font-serif-cn leading-none text-paper/[0.055] ${glyphClass}`}
          aria-hidden="true"
        >
          {glyph}
        </span>

        <div class="light-beam" aria-hidden="true" />

        {!isWide && <div class="absolute inset-3 border border-paper/10 md:inset-4" aria-hidden="true" />}

        {!plain && (
          <div class="absolute inset-0 flex flex-col justify-between">
            <div class={`flex items-start justify-between gap-3 ${compact ? 'p-3' : 'p-4 md:p-5'}`}>
              <span class="font-sans text-[0.55rem] font-medium uppercase tracking-[0.24em] text-paper/60">
                {label ?? 'CineScope'}
              </span>
              {year && (
                <span class="font-display text-[0.7rem] tracking-[0.2em] text-paper/50" aria-hidden="true">
                  {year}
                </span>
              )}
            </div>

            <div class={`relative ${compact ? 'px-5 pb-5' : 'px-5 pb-5 md:px-7 md:pb-7'}`}>
              <div class="mb-2.5 h-px w-7 bg-gold/80" />
              <h3
                class={`font-serif-cn leading-[1.22] text-paper ${
                  compact ? 'text-[1.05rem]' : isWide ? 'text-[1.6rem] md:text-[2.1rem]' : 'text-[1.4rem] md:text-[1.6rem]'
                }`}
              >
                {title}
              </h3>
              {originalTitle && !compact && (
                <p class="mt-2 font-display text-[0.7rem] italic uppercase tracking-[0.14em] text-paper/50">
                  {originalTitle}
                </p>
              )}
            </div>
          </div>
        )}
      </div>
    )
  }
  <div
    class="pointer-events-none absolute inset-0 z-[3]"
    style="background: linear-gradient(to top, rgba(5,5,6,0.5), rgba(5,5,6,0) 60%);"
  >
  </div>
</div>
