# ---- CineScope 运行配置 ----
# 复制为仓库根目录 .env 后填写。所有密钥只放在服务器本地，不提交到 Git。

# PostgreSQL 15+（生产端唯一的数据源）
DATABASE_URL=postgresql://cinescope:change-me@127.0.0.1:5432/cinescope

# TMDb：推荐使用 v4 Read Access Token；也可只填 v3 API Key
TMDB_API_TOKEN=
TMDB_API_KEY=
TMDB_REGION=CN
TMDB_LANGUAGE=zh-CN

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 发布
SITE_URL=https://cinescope.pages.dev
CLOUDFLARE_DEPLOY_HOOK=

# 日期计算时区（每日刊物按此时区确定「今天」）
PIPELINE_TIMEZONE=Asia/Shanghai
