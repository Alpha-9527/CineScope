---
import Artwork from './Artwork.astro';

interface Props {
  film: {
    slug: string;
    data: {
      title: string;
      originalTitle: string;
      year: number;
      countries: string[];
      directors: string[];
      genres: string[];
      palette: string;
      poster?: string;
      runtime: number;
    };
  };
  index?: number;
  note?: string;
  size?: 'default' | 'large';
  eager?: boolean;
}

const { film, index, note, size = 'default', eager = false } = Astro.props;
const { data } = film;
---

<article class="group relative flex flex-col">
  <a href={`/films/${film.slug}/`} class="block focus-visible:outline-none">
    <div class="relative overflow-hidden">
      <Artwork
        palette={data.palette}
        title={data.title}
        originalTitle={data.originalTitle}
        year={data.year}
        label={index !== undefined ? `NO.${String(index + 1).padStart(2, '0')}` : 'CineScope'}
        src={data.poster}
        alt={`${data.title}（${data.year}）海报`}
        ratio={size === 'large' ? 'wide' : 'poster'}
        eager={eager}
      />
      <div
        class="pointer-events-none absolute inset-0 z-[4] opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        style="box-shadow: inset 0 0 0 1px rgba(194,162,115,0.35);"
      >
      </div>
    </div>
  </a>

  <div class="flex flex-1 flex-col pt-4">
    <div class="flex items-baseline gap-2 text-[0.65rem] uppercase tracking-[0.18em] text-muted">
      <span>{data.year}</span>
      <span class="text-line">/</span>
      <span class="truncate">{data.countries.join(' · ')}</span>
    </div>

    <h3 class={`mt-2 font-serif-cn leading-snug ${size === 'large' ? 'text-2xl md:text-[1.9rem]' : 'text-xl'}`}>
      <a href={`/films/${film.slug}/`} class="link-underline text-paper">
        {data.title}
      </a>
    </h3>

    <p class="mt-1 font-display text-[0.72rem] uppercase tracking-[0.14em] text-muted/80">
      {data.originalTitle}
    </p>

    <p class="mt-2.5 text-[0.8rem] leading-relaxed text-muted">
      {data.directors.join('、')} 导演
      <span class="mx-1.5 text-line">·</span>
      {data.genres.slice(0, 2).join(' / ')}
    </p>

    {
      note && (
        <p class="mt-3 border-l border-line pl-3 text-[0.83rem] leading-relaxed text-paper-dim/85">
          {note}
        </p>
      )
    }
  </div>
</article>
