---
import { formatRuntime } from '../lib/site';

interface Props {
  film: {
    data: {
      year: number;
      countries: string[];
      language: string;
      runtime: number;
      directors: string[];
      cast: string[];
      genres: string[];
      ratings: { imdb?: number; votes?: number; source: string };
      scores: {
        audience: number;
        artistic: number;
        recommendation: number;
        confidence: number;
        final: number;
      };
      dataStatus: 'sample' | 'verified';
    };
  };
}

const { data } = Astro.props.film;

const rows = [
  { label: '上映', value: String(data.year) },
  { label: '制作国家', value: data.countries.join(' / ') },
  { label: '原始语言', value: data.language },
  { label: '片长', value: formatRuntime(data.runtime) },
  { label: '导演', value: data.directors.join('、') },
  { label: '类型', value: data.genres.join(' / ') },
];

const scores = [
  { label: '观众口碑', key: 'R', value: data.scores.audience },
  { label: '艺术价值', key: 'A', value: data.scores.artistic },
  { label: '推荐价值', key: 'D', value: data.scores.recommendation },
];
---

<div>
  <div class="border-t border-line pt-5">
    <p class="kicker">影片资料</p>
    <dl class="mt-5 space-y-3.5">
      {
        rows.map((row) => (
          <div class="grid grid-cols-[4.5rem_1fr] gap-3 text-[0.78rem] leading-relaxed">
            <dt class="text-muted">{row.label}</dt>
            <dd class="text-paper-dim">{row.value}</dd>
          </div>
        ))
      }
      {
        data.cast.length > 0 && (
          <div class="grid grid-cols-[4.5rem_1fr] gap-3 text-[0.78rem] leading-relaxed">
            <dt class="text-muted">主演</dt>
            <dd class="text-paper-dim">{data.cast.slice(0, 4).join('、')}</dd>
          </div>
        )
      }
    </dl>
  </div>

  <div class="mt-8 border-t border-line pt-5">
    <div class="flex items-end justify-between">
      <p class="kicker">编辑部评估</p>
      <div class="text-right">
        <span class="font-display text-2xl leading-none text-gold">{data.scores.final}</span>
        <span class="ml-1 text-[0.6rem] tracking-[0.1em] text-muted">/100</span>
      </div>
    </div>

    <ul class="mt-5 space-y-3">
      {
        scores.map((score) => (
          <li>
            <div class="flex items-center justify-between text-[0.7rem] tracking-[0.08em] text-muted">
              <span>{score.label}</span>
              <span class="text-paper-dim/80">
                {score.key} · {score.value}
              </span>
            </div>
            <div class="mt-1.5 h-px w-full bg-line">
              <div class="h-px bg-gold/80" style={`width: ${score.value}%`} />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 border-t border-line-soft pt-3">
      <div class="flex items-center justify-between text-[0.68rem] text-muted">
        <span>证据可信度</span>
        <span class="text-paper-dim/80">C · {Math.round(data.scores.confidence * 100)}%</span>
      </div>
      <div class="mt-1.5 h-px w-full bg-line">
        <div
          class="h-px bg-gold/80"
          style={`width: ${Math.round(data.scores.confidence * 100)}%`}
        />
      </div>
    </div>

    {
      data.ratings.imdb !== undefined && (
        <p class="mt-3 text-[0.68rem] leading-relaxed text-muted/75">
          IMDb 参考 {data.ratings.imdb.toFixed(1)}
          {data.ratings.votes ? `（${Intl.NumberFormat('zh-CN').format(data.ratings.votes)} 票）` : ''}
          · {data.ratings.source}
        </p>
      )
    }
    {
      data.dataStatus === 'sample' && (
        <p class="mt-2 text-[0.65rem] leading-relaxed text-muted/55">
          当前为演示数据，接入 TMDb / IMDb 数据集后自动替换为核实值。
        </p>
      )
    }
  </div>
</div>
