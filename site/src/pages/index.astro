---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FilmCard from '../components/FilmCard.astro';
import MagazineCover from '../components/MagazineCover.astro';
import EditorialCard from '../components/EditorialCard.astro';
import { getDaily, getFeatures, getFilmMap, getMagazines } from '../lib/content';
import { SITE, formatDateShort, issueLabel, weekLabel } from '../lib/site';

const [dailies, magazines, features, filmMap] = await Promise.all([
  getDaily(),
  getMagazines(),
  getFeatures(),
  getFilmMap(),
]);

const latestDaily = dailies[0];
const latestMagazine = magazines[0];
const leadFilm = filmMap.get(latestDaily.data.films[0].slug);
const dailyFilms = latestDaily.data.films
  .map((item) => ({ item, film: filmMap.get(item.slug) }))
  .filter((entry): entry is { item: (typeof latestDaily.data.films)[number]; film: NonNullable<ReturnType<typeof filmMap.get>> } => Boolean(entry.film));

const magazinePicks = latestMagazine.data.picks
  .map((pick) => ({ pick, film: filmMap.get(pick.slug) }))
  .filter((entry): entry is { pick: (typeof latestMagazine.data.picks)[number]; film: NonNullable<ReturnType<typeof filmMap.get>> } => Boolean(entry.film));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: 'CineScope 全球电影杂志',
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    description: '由 AI 编辑部持续出版的全球电影杂志',
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  {
    leadFilm && (
      <HeroSection
        edition={{ slug: latestDaily.id, data: latestDaily.data }}
        film={leadFilm}
        count={dailyFilms.length}
      />
    )
  }

  <div class="shell">
    <section class="mt-16 md:mt-24" aria-labelledby="today-title">
      <SectionHeading
        kicker={`今日精选 · ${issueLabel(latestDaily.data.issue)}`}
        title={latestDaily.data.title}
        description={latestDaily.data.subtitle}
        href={`/daily/${latestDaily.id}/`}
        linkLabel="阅读本期全文"
      />

      <div class="mt-10 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          dailyFilms.map(({ item, film }, index) => (
            <FilmCard film={film} index={index} note={item.note} />
          ))
        }
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-line-soft pt-6 text-[0.72rem] text-muted">
        <span class="tracking-[0.12em]">{formatDateShort(latestDaily.data.date)}</span>
        <span class="h-3 w-px bg-line" aria-hidden="true"></span>
        <span>本期编辑导语由 AI 主编撰写</span>
        <span class="h-3 w-px bg-line" aria-hidden="true"></span>
        <a href="/daily/" class="link-underline text-paper-dim">浏览全部每日推荐</a>
      </div>
    </section>

    <section class="mt-20 md:mt-28" aria-labelledby="weekly-title">
      <SectionHeading
        kicker="本期周刊"
        title="CineScope Weekly"
        description="每周一期，独立策划，不复述每日内容。"
        href="/magazine/"
        linkLabel="全部周刊"
      />

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <MagazineCover issue={{ slug: latestMagazine.id, data: latestMagazine.data }} />
        </div>

        <div class="lg:col-span-7">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.68rem] uppercase tracking-[0.18em] text-muted">
            <span class="text-gold">{weekLabel(latestMagazine.data.year, latestMagazine.data.week)}</span>
            <span class="h-3 w-px bg-line" aria-hidden="true"></span>
            <span>主题 · {latestMagazine.data.theme}</span>
          </div>

          <p class="mt-6 text-[0.92rem] leading-loose text-paper-dim/85">
            {latestMagazine.data.editorIntro}
          </p>

          <ol class="mt-9 border-t border-line">
            {
              magazinePicks.map(({ pick, film }, index) => (
                <li class="border-b border-line-soft">
                  <a
                    href={`/films/${film.slug}/`}
                    class="group flex items-start gap-5 py-4 transition-colors hover:bg-white/[0.015]"
                  >
                    <span class="mt-1 font-display text-[0.8rem] tracking-[0.12em] text-gold/70">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="flex-1">
                      <span class="flex flex-wrap items-baseline gap-x-3">
                        <span class="font-serif-cn text-[1.02rem] text-paper transition-colors group-hover:text-gold">
                          {film.data.title}
                        </span>
                        <span class="text-[0.65rem] uppercase tracking-[0.14em] text-muted">
                          {film.data.year} · {film.data.countries[0]}
                        </span>
                      </span>
                      <span class="mt-1 block text-[0.8rem] leading-relaxed text-muted">
                        {pick.note}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>

          <div class="mt-8">
            <a
              href={`/magazine/${latestMagazine.id}/`}
              class="group inline-flex items-center gap-3 border border-line px-5 py-2.5 text-[0.7rem] uppercase tracking-[0.16em] text-paper-dim transition-colors hover:border-gold hover:text-gold"
            >
              读本期周刊
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-20 md:mt-28" aria-labelledby="features-title">
      <SectionHeading
        kicker="编辑专题"
        title="比推荐更长一点的阅读"
        description="不受每日与每周节奏限制，围绕一个值得展开的问题。"
        href="/features/"
        linkLabel="全部专题"
      />

      <div class="mt-10 grid gap-x-7 gap-y-12 md:grid-cols-3">
        {features.slice(0, 3).map((feature, index) => (
          <EditorialCard feature={{ ...feature, slug: feature.id }} index={index} />
        ))}
      </div>
    </section>

    <section class="mt-20 border-t border-line pt-10 md:mt-28" aria-labelledby="archive-title">
      <SectionHeading
        kicker="往期"
        title="已出版的刊物"
        href="/archive/"
        linkLabel="进入归档"
      />

      <div class="mt-8 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          dailies.slice(0, 6).map((edition) => (
            <a
              href={`/daily/${edition.id}/`}
              class="group flex items-baseline justify-between gap-4 border-b border-line-soft py-3"
            >
              <span class="font-serif-cn text-[0.95rem] text-paper-dim transition-colors group-hover:text-gold">
                {edition.data.title}
              </span>
              <span class="shrink-0 text-[0.65rem] uppercase tracking-[0.12em] text-muted">
                {formatDateShort(edition.data.date)}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mt-20 md:mt-24" aria-label="编辑部说明">
      <div class="border border-line bg-card/40 px-6 py-10 md:px-12 md:py-14">
        <p class="kicker">编辑部</p>
        <p class="mt-5 max-w-3xl font-serif-cn text-xl leading-relaxed text-paper md:text-2xl">
          我们不追逐热门，也不把评分当作结论。CineScope 每天主动从世界各地的电影里寻找值得被看见的作品，并在推荐时说明理由。
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-[0.75rem] text-muted">
          <span>每日 09:00 更新</span>
          <span>每周日 20:00 出版周刊</span>
          <a href="/about/" class="link-underline text-paper-dim">了解我们的编辑方法</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
