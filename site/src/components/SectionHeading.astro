---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  align?: 'left' | 'center';
}

const {
  kicker,
  title,
  description,
  href,
  linkLabel = '查看全部',
  align = 'left',
} = Astro.props;
---

<div
  class={`flex flex-col gap-5 border-t border-line pt-6 md:flex-row md:items-end md:justify-between ${
    align === 'center' ? 'text-center md:text-center' : ''
  }`}
>
  <div>
    {kicker && <p class="kicker">{kicker}</p>}
    <h2 class="mt-3 font-serif-cn text-2xl leading-tight text-paper md:text-[2rem]">{title}</h2>
    {description && (
      <p class="mt-2.5 max-w-xl text-[0.82rem] leading-relaxed text-muted">{description}</p>
    )}
  </div>
  {
    href && (
      <a
        href={href}
        class="group inline-flex shrink-0 items-center gap-2 font-sans text-[0.7rem] uppercase tracking-[0.16em] text-muted transition-colors hover:text-gold"
      >
        {linkLabel}
        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
          →
        </span>
      </a>
    )
  }
</div>
