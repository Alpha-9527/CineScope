---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Artwork from '../../components/Artwork.astro';
import FilmCard from '../../components/FilmCard.astro';
import { getFilmMap, getMagazines } from '../../lib/content';
import { SITE, formatDate, weekLabel } from '../../lib/site';

export async function getStaticPaths() {
  const issues = await getMagazines();
  return issues.map((issue, index) => ({
    params: { slug: issue.id },
    props: { issue, next: issues[index - 1], prev: issues[index + 1] },
  }));
}

const { issue, next, prev } = Astro.props;
const filmMap = await getFilmMap();
const { Content } = await render(issue);

const lead = issue.data.leadFilm ? filmMap.get(issue.data.leadFilm) : undefined;

const picks = issue.data.picks
  .map((pick) => ({ pick, film: filmMap.get(pick.slug) }))
  .filter((entry): entry is { pick: (typeof issue.data.picks)[number]; film: NonNullable<ReturnType<typeof filmMap.get>> } => Boolean(entry.film));

const finds = issue.data.specialFinds
  .map((pick) => ({ pick, film: filmMap.get(pick.slug) }))
  .filter((entry): entry is { pick: (typeof issue.data.specialFinds)[number]; film: NonNullable<ReturnType<typeof filmMap.get>> } => Boolean(entry.film));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PublicationIssue',
  name: issue.data.title,
  issueNumber: issue.data.week,
  datePublished: issue.data.date,
  inLanguage: 'zh-CN',
  isPartOf: { '@type': 'Periodical', name: `${SITE.name} Weekly` },
};
---

<BaseLayout
  title={`${issue.data.title} · 第 ${issue.data.week} 周`}
  description={issue.data.subtitle}
  type="article"
  publishedAt={issue.data.date}
  jsonLd={jsonLd}
>
  <article>
    <div class="shell pt-12 md:pt-16">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <div class="relative">
            <Artwork
              palette={issue.data.coverPalette}
              title={issue.data.theme}
              label={`CineScope Weekly · W${String(issue.data.week).padStart(2, '0')}`}
              year={issue.data.year}
              ratio="portrait"
              eager
            />
          </div>
        </div>

        <div class="flex flex-col justify-center lg:col-span-7">
          <p class="kicker">Weekly · 第 {issue.data.week} 周</p>
          <h1 class="mt-5 font-serif-cn text-[2.1rem] leading-[1.22] text-paper md:text-[3rem]">
            {issue.data.title}
          </h1>
          <p class="mt-4 font-display text-base italic tracking-[0.06em] text-muted">
            {weekLabel(issue.data.year, issue.data.week)} · 主题：{issue.data.theme}
          </p>
          <p class="mt-5 max-w-xl text-[0.92rem] leading-loose text-paper-dim/85">
            {issue.data.subtitle}
          </p>

          <div class="mt-8 border-t border-line pt-6">
            <p class="kicker">主编导语</p>
            <p class="mt-4 max-w-xl text-[0.9rem] leading-loose text-paper-dim/80">
              {issue.data.editorIntro}
            </p>
          </div>

          <p class="mt-8 text-[0.66rem] uppercase tracking-[0.18em] text-muted/70">
            出版于 {formatDate(issue.data.date)} · CineScope AI 编辑部
          </p>
        </div>
      </div>
    </div>

    {
      lead && (
        <div class="shell mt-16 md:mt-20">
          <div class="relative overflow-hidden border border-line">
            <Artwork
              palette={lead.data.palette}
              title={lead.data.title}
              originalTitle={lead.data.originalTitle}
              year={lead.data.year}
              label={`本期封面影片 · ${lead.data.countries[0]}`}
              src={lead.data.backdrop}
              alt={`${lead.data.title} 剧照`}
              ratio="wide"
            />
            <div class="absolute inset-0 z-[4] flex items-end bg-gradient-to-t from-ink/90 via-ink/20 to-transparent p-6 md:p-10">
              <div>
                <p class="kicker">Cover Film</p>
                <a
                  href={`/films/${lead.slug}/`}
                  class="mt-2 block font-serif-cn text-2xl text-paper transition-colors hover:text-gold md:text-4xl"
                >
                  {lead.data.title}
                </a>
              </div>
            </div>
          </div>
        </div>
      )
    }

    <div class="shell mt-16 md:mt-20">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-7">
          <div class="article-body">
            <Content />
          </div>

          <section class="mt-14 border-t border-line pt-8">
            <h2 class="kicker">编辑总结</h2>
            <p class="mt-5 font-serif-cn text-[1.12rem] leading-loose text-paper/90">
              {issue.data.closing}
            </p>
          </section>
        </div>

        <aside class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <p class="kicker">本期目录</p>
            <ol class="mt-5 border-t border-line">
              {
                picks.map(({ film }, index) => (
                  <li class="border-b border-line-soft">
                    <a href={`/films/${film.slug}/`} class="group flex gap-4 py-3.5">
                      <span class="mt-0.5 font-display text-[0.75rem] text-gold/70">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span>
                        <span class="block font-serif-cn text-[0.95rem] text-paper-dim group-hover:text-gold">
                          {film.data.title}
                        </span>
                        <span class="mt-0.5 block text-[0.68rem] uppercase tracking-[0.1em] text-muted">
                          {film.data.year} · {film.data.countries[0]}
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>

            <div class="mt-10">
              <p class="kicker">特别发现</p>
              <ul class="mt-4 space-y-4">
                {
                  finds.map(({ pick, film }) => (
                    <li class="border-l border-gold-dim/60 pl-4">
                      <a href={`/films/${film.slug}/`} class="group">
                        <span class="block font-serif-cn text-[0.95rem] text-paper-dim group-hover:text-gold">
                          {film.data.title}
                        </span>
                        <span class="mt-1 block text-[0.76rem] leading-relaxed text-muted">
                          {pick.note}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div class="shell mt-16 md:mt-20">
      <div class="border-t border-line pt-8">
        <p class="kicker">本期电影精选</p>
      </div>
      <div class="mt-8 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          picks.map(({ pick, film }, index) => (
            <FilmCard film={film} index={index} note={pick.note} />
          ))
        }
      </div>
    </div>

    <nav class="shell mt-20 border-t border-line pt-8" aria-label="周刊导航">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div>
          {prev && (
            <a href={`/magazine/${prev.id}/`} class="group block">
              <span class="text-[0.65rem] uppercase tracking-[0.18em] text-muted">上一期</span>
              <span class="mt-1.5 block font-serif-cn text-lg text-paper-dim group-hover:text-gold">
                {prev.data.title}
              </span>
            </a>
          )}
        </div>
        <a href="/magazine/" class="text-[0.7rem] uppercase tracking-[0.16em] text-muted hover:text-gold">
          全部周刊
        </a>
        <div class="sm:text-right">
          {next && (
            <a href={`/magazine/${next.id}/`} class="group block">
              <span class="text-[0.65rem] uppercase tracking-[0.18em] text-muted">下一期</span>
              <span class="mt-1.5 block font-serif-cn text-lg text-paper-dim group-hover:text-gold">
                {next.data.title}
              </span>
            </a>
          )}
        </div>
      </div>
    </nav>
  </article>
</BaseLayout>
